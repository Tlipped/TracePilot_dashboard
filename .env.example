# Local-only development.
VITE_BACKEND_HTTP_URL=http://localhost:8000

# Optional. If omitted, the frontend derives ws:// or wss:// from VITE_BACKEND_HTTP_URL.
# VITE_BACKEND_WS_URL=ws://localhost:8000

# LAN demo. Replace 172.27.37.28 with your WiFi IPv4 address from `ipconfig`.
# VITE_BACKEND_HTTP_URL=http://172.27.37.28:8000
# VITE_BACKEND_WS_URL=ws://172.27.37.28:8000
